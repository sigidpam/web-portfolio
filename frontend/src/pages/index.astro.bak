---
// Import komponen wajib ada di sini agar tidak error "not defined"
import ExperienceCard from '../components/ExperienceCard.astro';

// Mengambil data langsung dari backend D1 Cloudflare kamu
const response = await fetch('https://backend.anisqurli-g.workers.dev/api/experience');
const result = await response.json();
const experiences = result.data || [];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Portfolio - Pengalaman Kerja</title>
  </head>
  <body class="bg-gray-900 text-white min-h-screen p-8 font-sans">
    <main class="max-w-3xl mx-auto">
      <h1 class="text-4xl font-bold mb-8 border-b border-gray-700 pb-4">Pengalaman Kerja</h1>
      
      <div class="space-y-6">
        {experiences.map((exp: any) => (
          <ExperienceCard 
            company={exp.company}
            title={exp.title}
            period={exp.period}
            location={exp.location}
            description={exp.description}
          />
        ))}
      </div>
    </main>
  </body>
</html>
