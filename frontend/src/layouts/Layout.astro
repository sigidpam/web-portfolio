---
// frontend/src/layouts/Layout.astro
import '../styles/global.css'; // Add this line!

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Sigid Pamungkas - Senior Cloud Engineer Portfolio" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-[#0a0a0a] text-zinc-100 font-sans antialiased selection:bg-zinc-700 selection:text-white">
    <slot />
  </body>
</html>
